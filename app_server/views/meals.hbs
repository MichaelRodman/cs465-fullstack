<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
    <meta charset="UTF-8">
    <title>Meals - Travlr Getaways</title>
    <link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header }}

            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">
                            <h1>Meals</h1>
                            <ul id="foods">
                                {{#each meals}}
                                <li>
                                    <h2>
                                        <a href="/meals">{{category}}</a>
                                    </h2>
                                    <div class="infos">
                                        <a href="/meals">
                                            <img src="images/{{image}}" alt="{{alt}}" height="169" width="780">
                                            <span class="cover"></span>
                                        </a>
                                        <p>
                                            <span>{{name}}</span>
                                            {{description}}
                                        </p>
                                    </div>
                                </li>
                                {{/each}}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{> footer }}
    </div>
</body>
</html>